# To use API key pooling/rotation to bypass rate limits, provide multiple keys separated by commas
GEMINI_API_KEY=key1,key2,key3

# --- Fallback Architecture Keys ---
# If LLM_PROVIDER=auto, the system tries Gemini first and automatically 
# falls back to Groq if the Gemini free-tier rate limit is hit.
# You can also use comma-separated keys for Groq pooling.
GROQ_API_KEY=key1,key2
GROQ_MODEL_NAME=qwen/qwen3.8-27b

# Optional settings
SELECTED_BRAND=AppleSupport # Change this to process a different brand (e.g. Delta, Uber_Support)
LLM_PROVIDER=auto # Options: 'auto' (Gemini+Groq fallback), 'gemini', or 'groq'
MODEL_NAME=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5
CONFIDENCE_THRESHOLD=0.7
